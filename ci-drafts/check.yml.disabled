# DRAFT ONLY: not under .github/workflows, not enabled, no deployment.
# Before activation, replace third-party actions with audited immutable SHAs.
name: ModelAtlas checks draft
on: [push, pull_request]
permissions:
  contents: read
jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      # Checkout action deliberately omitted pending immutable-SHA audit.
      - run: echo 'Draft requires an explicitly audited checkout step' && exit 1
      - run: python3 scripts/build.py
      - run: python3 -m unittest discover -s tests -v
      - run: node --check web/app.js && node --test tests/core.test.js
